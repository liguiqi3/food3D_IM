#: f1e73a67963d47958c6b745518bc245f
msgid "Chooses static or shared library output, subject to the Windows fallback."
msgstr "选择静态库或共享库，但 Windows 有退回静态库的限制。"

#: ../../home/min/project/food3d_im/docs/sphinx/source/components/meta.rst:21
